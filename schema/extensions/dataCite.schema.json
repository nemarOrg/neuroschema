{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dataCite.schema.json",
  "title": "DataCite Extension",
  "description": "DataCite-specific metadata for DOI registration (kernel 4.6). Fields here are specific to the DataCite registration format and are not universally needed. Universal scholarly metadata (keywords, related_identifiers, contributors, dates, rights, language) has moved to the core dataset schema as of v0.3.0.",
  "type": "object",
  "properties": {
    "publisher": {
      "type": ["string", "null"],
      "description": "Name of the entity that holds/publishes the data (e.g., 'NEMAR', 'OpenNeuro')."
    },
    "publisher_identifier": {
      "type": ["string", "null"],
      "description": "Persistent identifier for the publisher (e.g., ROR ID for the institution)."
    },
    "publisher_identifier_scheme": {
      "type": ["string", "null"],
      "description": "Scheme for the publisher identifier (e.g., 'ROR', 'ISNI')."
    },
    "publication_year": {
      "type": ["integer", "null"],
      "description": "Year when the dataset was first published or made available."
    },
    "resource_type": {
      "type": ["string", "null"],
      "description": "Free-text description of the resource type (e.g., 'EEG Dataset', 'EMG Dataset')."
    },
    "resource_type_general": {
      "type": ["string", "null"],
      "description": "DataCite controlled vocabulary for general resource type.",
      "enum": [
        "Audiovisual", "Award", "Book", "BookChapter", "Collection",
        "ComputationalNotebook", "ConferencePaper", "ConferenceProceeding",
        "DataPaper", "Dataset", "Dissertation", "Event", "Image",
        "InputOutput", "Instrument", "InteractiveResource", "Journal",
        "JournalArticle", "Model", "OutputManagementPlan", "PeerReview",
        "PhysicalObject", "Preprint", "Project", "Report", "Service",
        "Software", "Sound", "Standard", "StudyRegistration", "Text",
        "Workflow", "Other", null
      ]
    },
    "geo_locations": {
      "type": "array",
      "description": "Geographic locations where the data was collected or about which the data is focused. Coordinates use WGS 84.",
      "items": {
        "type": "object",
        "properties": {
          "place": {
            "type": ["string", "null"],
            "description": "Free-text description of the location (e.g., 'Fudan University, Shanghai, China')."
          },
          "point": {
            "type": ["object", "null"],
            "description": "Geographic coordinates (WGS 84).",
            "properties": {
              "latitude": { "type": "number", "minimum": -90, "maximum": 90 },
              "longitude": { "type": "number", "minimum": -180, "maximum": 180 }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    },
    "alternate_identifiers": {
      "type": "array",
      "description": "Other identifiers for this dataset besides the DOI (e.g., platform-specific IDs like 'nm000108' for NEMAR, 'ds005516' for OpenNeuro).",
      "items": {
        "type": "object",
        "required": ["identifier"],
        "properties": {
          "identifier": {
            "type": "string",
            "description": "The alternate identifier value."
          },
          "identifier_type": {
            "type": ["string", "null"],
            "description": "Type or source of the alternate identifier (e.g., 'NEMAR', 'OpenNeuro', 'PhysioNet')."
          }
        },
        "additionalProperties": false
      }
    },
    "related_items": {
      "type": "array",
      "description": "Full bibliographic references for related items (DataCite property 20). Use when you need to cite a resource with complete bibliographic detail (title, authors, journal, pages) rather than just an identifier link.",
      "items": {
        "type": "object",
        "required": ["relation_type", "related_item_type"],
        "properties": {
          "relation_type": {
            "type": "string",
            "description": "Relationship of the related item to this dataset.",
            "enum": [
              "IsCitedBy", "Cites", "IsSupplementTo", "IsSupplementedBy",
              "IsDescribedBy", "Describes", "References", "IsReferencedBy",
              "IsDerivedFrom", "IsSourceOf", "IsPartOf", "HasPart"
            ]
          },
          "related_item_type": {
            "type": "string",
            "description": "Type of the related item.",
            "enum": [
              "JournalArticle", "Book", "BookChapter", "ConferencePaper",
              "Preprint", "DataPaper", "Dissertation", "Report", "Text",
              "Dataset", "Software", "Other"
            ]
          },
          "related_item_identifier": {
            "type": ["object", "null"],
            "description": "Identifier for the related item.",
            "properties": {
              "identifier": { "type": "string" },
              "identifier_type": {
                "type": "string",
                "enum": ["DOI", "ISSN", "ISBN", "PMID", "URL", "arXiv"]
              }
            },
            "additionalProperties": false
          },
          "title": {
            "type": ["string", "null"],
            "description": "Title of the related item."
          },
          "creators": {
            "type": "array",
            "description": "Authors of the related item.",
            "items": { "$ref": "../definitions/person.schema.json" }
          },
          "publication_year": {
            "type": ["integer", "null"],
            "description": "Publication year of the related item."
          },
          "volume": { "type": ["string", "null"] },
          "issue": { "type": ["string", "null"] },
          "first_page": { "type": ["string", "null"] },
          "last_page": { "type": ["string", "null"] },
          "publisher": { "type": ["string", "null"] }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": true
}
