{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "kind.nemar.sensor-field.v1.schema.json",
  "title": "View Kind nemar.sensor-field, Version 1",
  "description": "A generic scalp map, applied on top of the envelope to a view declaration whose kind is nemar.sensor-field and kind_version 1. The role values holds one or more maps, each one value per sensor. The sensors are placed by one of three sources: the role layout (each sensor's theta and radius), the role positions (each sensor's x, y and z, which the transform nemar.sensor-layout.v1 projects to a layout, and which the view then declares as its transform), or, with neither, the sensor names, which a renderer places by nemar.sensor-labels.v1. A view has at most one of layout and positions, and the values' sensor coordinates are that role's name column, by position. The role that names the sensors (positions, or values with no sensor role) may carry the recording's cap_model and reference, which a placement by name reads; a layout carries neither. A renderer draws each map with the algorithm nemar.sensor-field.v1 (docs/views/sensor-field.md). A generic kind: no base and no inputs.",
  "type": "object",
  "required": [
    "data"
  ],
  "properties": {
    "base": {
      "not": {},
      "description": "A generic kind has no base."
    },
    "base_version": {
      "not": {},
      "description": "A generic kind has no base."
    },
    "inputs": {
      "not": {},
      "description": "A scalp map is drawn from stored data only."
    },
    "transform": {
      "type": "object",
      "description": "With the role positions, the transform nemar.sensor-layout.v1, which projects them; without it, none.",
      "properties": {
        "name": {
          "const": "nemar.sensor-layout.v1"
        }
      },
      "required": [
        "name"
      ]
    },
    "parameters": {
      "type": "object",
      "description": "How the maps are drawn.",
      "properties": {
        "limits": {
          "type": "string",
          "enum": [
            "absmax",
            "minmax"
          ],
          "default": "absmax",
          "description": "The color limits: absmax is symmetric about zero (plus and minus the largest magnitude, for a diverging map); minmax is the smallest and largest value (for a sequential map). Absent means absmax."
        }
      },
      "additionalProperties": false
    },
    "data": {
      "type": "array",
      "description": "The role values, exactly once; at most one of the roles layout and positions.",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "description": "The role values: one or more maps over the sensor dimension. With the sensor dimension along the rows, each declared number column is a map; along the columns, each data row is a map, and the declared number columns are the sensors. A second dimension, of any name, along the other axis labels the maps.",
            "required": [
              "role",
              "format",
              "columns",
              "dims"
            ],
            "properties": {
              "role": {
                "const": "values"
              },
              "format": {
                "const": "tsv"
              },
              "dims": {
                "type": "array",
                "minItems": 1,
                "maxItems": 2,
                "description": "The sensor dimension, and at most one more along the other axis.",
                "items": {
                  "type": "object",
                  "if": {
                    "type": "object",
                    "properties": {
                      "name": {
                        "const": "sensor"
                      }
                    },
                    "required": [
                      "name"
                    ]
                  },
                  "then": {
                    "type": "object",
                    "properties": {
                      "type": {
                        "const": "string",
                        "description": "Sensors are named."
                      }
                    },
                    "anyOf": [
                      {
                        "type": "object",
                        "description": "Sensors along the rows: names in a column of this file, or the layout's rows.",
                        "properties": {
                          "axis": {
                            "const": "rows"
                          },
                          "coords": {
                            "type": "object",
                            "not": {
                              "required": [
                                "header"
                              ]
                            }
                          }
                        }
                      },
                      {
                        "type": "object",
                        "description": "Sensors along the columns: names in this file's header, or the layout's rows.",
                        "properties": {
                          "axis": {
                            "const": "columns"
                          },
                          "coords": {
                            "type": "object",
                            "anyOf": [
                              {
                                "required": [
                                  "header"
                                ]
                              },
                              {
                                "required": [
                                  "role"
                                ]
                              }
                            ]
                          }
                        }
                      }
                    ]
                  }
                },
                "contains": {
                  "type": "object",
                  "properties": {
                    "name": {
                      "const": "sensor"
                    }
                  },
                  "required": [
                    "name"
                  ]
                },
                "minContains": 1,
                "maxContains": 1,
                "allOf": [
                  {
                    "if": {
                      "type": "array",
                      "minItems": 2
                    },
                    "then": {
                      "type": "array",
                      "description": "Two dimensions run along different axes.",
                      "allOf": [
                        {
                          "contains": {
                            "type": "object",
                            "properties": {
                              "axis": {
                                "const": "rows"
                              }
                            },
                            "required": [
                              "axis"
                            ]
                          }
                        },
                        {
                          "contains": {
                            "type": "object",
                            "properties": {
                              "axis": {
                                "const": "columns"
                              }
                            },
                            "required": [
                              "axis"
                            ]
                          }
                        }
                      ]
                    }
                  }
                ]
              }
            }
          },
          {
            "type": "object",
            "description": "The role layout: each sensor's name, theta in degrees and radius (EEGLAB's topoplot coordinates: theta 0 at the nose and 90 at the right ear, radius 0.5 at the head's equator), one row per sensor, with the frame the layout came from and whether its positions were measured or taken from a template.",
            "required": [
              "role",
              "format",
              "columns",
              "dims",
              "coordinate_system",
              "position_source"
            ],
            "properties": {
              "role": {
                "const": "layout"
              },
              "format": {
                "const": "tsv"
              },
              "columns": {
                "type": "array",
                "description": "name, theta_deg and radius, each once, and sensor_type, required when position_source is measured.",
                "items": {
                  "type": "object",
                  "properties": {
                    "name": {
                      "enum": [
                        "name",
                        "theta_deg",
                        "radius",
                        "sensor_type"
                      ]
                    }
                  },
                  "allOf": [
                    {
                      "if": {
                        "type": "object",
                        "properties": {
                          "name": {
                            "enum": [
                              "name",
                              "sensor_type"
                            ]
                          }
                        },
                        "required": [
                          "name"
                        ]
                      },
                      "then": {
                        "type": "object",
                        "properties": {
                          "type": {
                            "const": "string"
                          }
                        }
                      }
                    },
                    {
                      "if": {
                        "type": "object",
                        "properties": {
                          "name": {
                            "const": "theta_deg"
                          }
                        },
                        "required": [
                          "name"
                        ]
                      },
                      "then": {
                        "type": "object",
                        "required": [
                          "unit"
                        ],
                        "properties": {
                          "type": {
                            "const": "number"
                          },
                          "unit": {
                            "const": "deg"
                          }
                        }
                      }
                    },
                    {
                      "if": {
                        "type": "object",
                        "properties": {
                          "name": {
                            "const": "radius"
                          }
                        },
                        "required": [
                          "name"
                        ]
                      },
                      "then": {
                        "type": "object",
                        "properties": {
                          "type": {
                            "const": "number"
                          }
                        }
                      }
                    }
                  ]
                },
                "allOf": [
                  {
                    "contains": {
                      "type": "object",
                      "properties": {
                        "name": {
                          "const": "name"
                        }
                      },
                      "required": [
                        "name"
                      ]
                    },
                    "minContains": 1,
                    "maxContains": 1
                  },
                  {
                    "contains": {
                      "type": "object",
                      "properties": {
                        "name": {
                          "const": "theta_deg"
                        }
                      },
                      "required": [
                        "name"
                      ]
                    },
                    "minContains": 1,
                    "maxContains": 1
                  },
                  {
                    "contains": {
                      "type": "object",
                      "properties": {
                        "name": {
                          "const": "radius"
                        }
                      },
                      "required": [
                        "name"
                      ]
                    },
                    "minContains": 1,
                    "maxContains": 1
                  }
                ]
              },
              "dims": {
                "type": "array",
                "minItems": 1,
                "maxItems": 1,
                "description": "The sensor dimension along the rows, named by the name column.",
                "items": {
                  "type": "object",
                  "properties": {
                    "name": {
                      "const": "sensor"
                    },
                    "axis": {
                      "const": "rows"
                    },
                    "type": {
                      "const": "string"
                    },
                    "coords": {
                      "type": "object",
                      "required": [
                        "column"
                      ],
                      "properties": {
                        "column": {
                          "const": "name"
                        }
                      },
                      "not": {
                        "required": [
                          "role"
                        ]
                      }
                    }
                  }
                }
              },
              "cap_model": {
                "not": {},
                "description": "A layout is drawn as stored and never placed by name, so it carries no cap model."
              },
              "reference": {
                "not": {},
                "description": "A layout is drawn as stored and never placed by name, so it carries no reference."
              }
            },
            "allOf": [
              {
                "if": {
                  "type": "object",
                  "properties": {
                    "position_source": {
                      "const": "measured"
                    }
                  },
                  "required": [
                    "position_source"
                  ]
                },
                "then": {
                  "type": "object",
                  "properties": {
                    "columns": {
                      "type": "array",
                      "contains": {
                        "type": "object",
                        "properties": {
                          "name": {
                            "const": "sensor_type"
                          }
                        },
                        "required": [
                          "name"
                        ]
                      }
                    }
                  }
                },
                "description": "A measured layout carries sensor_type: a scalp map draws the rows typed EEG and no untyped row, so an intracranial set that does not say what it is never reaches a scalp (the renderer refuses rows none of which is typed EEG with no_eeg_sensors). Template positions, from a montage, may be untyped."
              }
            ]
          },
          {
            "type": "object",
            "description": "The role positions: each sensor's name and three-dimensional position (x, y and z, in one unit), one row per sensor, in the frame coordinate_system names, or, for template positions, with the coordinate system n/a and the montage they came from (the envelope's rule for a template role). The view's transform nemar.sensor-layout.v1 projects them to a layout.",
            "required": [
              "role",
              "format",
              "columns",
              "dims",
              "coordinate_system",
              "position_source"
            ],
            "properties": {
              "role": {
                "const": "positions"
              },
              "format": {
                "const": "tsv"
              },
              "columns": {
                "type": "array",
                "description": "name, x, y and z, each once, and sensor_type, required when position_source is measured.",
                "items": {
                  "type": "object",
                  "properties": {
                    "name": {
                      "enum": [
                        "name",
                        "x",
                        "y",
                        "z",
                        "sensor_type"
                      ]
                    }
                  },
                  "allOf": [
                    {
                      "if": {
                        "type": "object",
                        "properties": {
                          "name": {
                            "enum": [
                              "name",
                              "sensor_type"
                            ]
                          }
                        },
                        "required": [
                          "name"
                        ]
                      },
                      "then": {
                        "type": "object",
                        "properties": {
                          "type": {
                            "const": "string"
                          }
                        }
                      }
                    },
                    {
                      "if": {
                        "type": "object",
                        "properties": {
                          "name": {
                            "enum": [
                              "x",
                              "y",
                              "z"
                            ]
                          }
                        },
                        "required": [
                          "name"
                        ]
                      },
                      "then": {
                        "type": "object",
                        "properties": {
                          "type": {
                            "const": "number"
                          }
                        }
                      }
                    }
                  ]
                },
                "allOf": [
                  {
                    "contains": {
                      "type": "object",
                      "properties": {
                        "name": {
                          "const": "name"
                        }
                      },
                      "required": [
                        "name"
                      ]
                    },
                    "minContains": 1,
                    "maxContains": 1
                  },
                  {
                    "contains": {
                      "type": "object",
                      "properties": {
                        "name": {
                          "const": "x"
                        }
                      },
                      "required": [
                        "name"
                      ]
                    },
                    "minContains": 1,
                    "maxContains": 1
                  },
                  {
                    "contains": {
                      "type": "object",
                      "properties": {
                        "name": {
                          "const": "y"
                        }
                      },
                      "required": [
                        "name"
                      ]
                    },
                    "minContains": 1,
                    "maxContains": 1
                  },
                  {
                    "contains": {
                      "type": "object",
                      "properties": {
                        "name": {
                          "const": "z"
                        }
                      },
                      "required": [
                        "name"
                      ]
                    },
                    "minContains": 1,
                    "maxContains": 1
                  }
                ]
              },
              "dims": {
                "type": "array",
                "minItems": 1,
                "maxItems": 1,
                "description": "The sensor dimension along the rows, named by the name column.",
                "items": {
                  "type": "object",
                  "properties": {
                    "name": {
                      "const": "sensor"
                    },
                    "axis": {
                      "const": "rows"
                    },
                    "type": {
                      "const": "string"
                    },
                    "coords": {
                      "type": "object",
                      "required": [
                        "column"
                      ],
                      "properties": {
                        "column": {
                          "const": "name"
                        }
                      },
                      "not": {
                        "required": [
                          "role"
                        ]
                      }
                    }
                  }
                }
              }
            },
            "allOf": [
              {
                "if": {
                  "type": "object",
                  "properties": {
                    "position_source": {
                      "const": "measured"
                    }
                  },
                  "required": [
                    "position_source"
                  ]
                },
                "then": {
                  "type": "object",
                  "properties": {
                    "columns": {
                      "type": "array",
                      "contains": {
                        "type": "object",
                        "properties": {
                          "name": {
                            "const": "sensor_type"
                          }
                        },
                        "required": [
                          "name"
                        ]
                      }
                    }
                  }
                },
                "description": "Measured positions carry sensor_type: a scalp map draws the rows typed EEG and no untyped row, so an intracranial set that does not say what it is never reaches a scalp (the renderer refuses rows none of which is typed EEG with no_eeg_sensors). Template positions, from a montage, may be untyped."
              }
            ]
          }
        ]
      },
      "allOf": [
        {
          "contains": {
            "type": "object",
            "properties": {
              "role": {
                "const": "values"
              }
            },
            "required": [
              "role"
            ]
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
            "properties": {
              "role": {
                "const": "layout"
              }
            },
            "required": [
              "role"
            ]
          },
          "minContains": 0,
          "maxContains": 1,
          "description": "The layout is optional (minContains 0)."
        },
        {
          "contains": {
            "type": "object",
            "properties": {
              "role": {
                "const": "positions"
              }
            },
            "required": [
              "role"
            ]
          },
          "minContains": 0,
          "maxContains": 1,
          "description": "The positions are optional (minContains 0)."
        },
        {
          "not": {
            "type": "array",
            "allOf": [
              {
                "contains": {
                  "type": "object",
                  "properties": {
                    "role": {
                      "const": "layout"
                    }
                  },
                  "required": [
                    "role"
                  ]
                }
              },
              {
                "contains": {
                  "type": "object",
                  "properties": {
                    "role": {
                      "const": "positions"
                    }
                  },
                  "required": [
                    "role"
                  ]
                }
              }
            ]
          },
          "description": "At most one of layout and positions places the sensors."
        },
        {
          "if": {
            "type": "array",
            "contains": {
              "type": "object",
              "properties": {
                "role": {
                  "const": "layout"
                }
              },
              "required": [
                "role"
              ]
            }
          },
          "then": {
            "type": "array",
            "items": {
              "if": {
                "type": "object",
                "properties": {
                  "role": {
                    "const": "values"
                  }
                },
                "required": [
                  "role"
                ]
              },
              "then": {
                "type": "object",
                "properties": {
                  "dims": {
                    "type": "array",
                    "items": {
                      "if": {
                        "type": "object",
                        "properties": {
                          "name": {
                            "const": "sensor"
                          }
                        },
                        "required": [
                          "name"
                        ]
                      },
                      "then": {
                        "type": "object",
                        "properties": {
                          "coords": {
                            "type": "object",
                            "required": [
                              "role",
                              "column"
                            ],
                            "properties": {
                              "role": {
                                "const": "layout"
                              },
                              "column": {
                                "const": "name"
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            },
            "description": "With a layout, the values' sensors are its rows: coordinates {role: layout, column: name}."
          }
        },
        {
          "if": {
            "type": "array",
            "contains": {
              "type": "object",
              "properties": {
                "role": {
                  "const": "positions"
                }
              },
              "required": [
                "role"
              ]
            }
          },
          "then": {
            "type": "array",
            "items": {
              "if": {
                "type": "object",
                "properties": {
                  "role": {
                    "const": "values"
                  }
                },
                "required": [
                  "role"
                ]
              },
              "then": {
                "type": "object",
                "properties": {
                  "dims": {
                    "type": "array",
                    "items": {
                      "if": {
                        "type": "object",
                        "properties": {
                          "name": {
                            "const": "sensor"
                          }
                        },
                        "required": [
                          "name"
                        ]
                      },
                      "then": {
                        "type": "object",
                        "properties": {
                          "coords": {
                            "type": "object",
                            "required": [
                              "role",
                              "column"
                            ],
                            "properties": {
                              "role": {
                                "const": "positions"
                              },
                              "column": {
                                "const": "name"
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            },
            "description": "With positions, the values' sensors are its rows: coordinates {role: positions, column: name}."
          }
        },
        {
          "if": {
            "type": "array",
            "not": {
              "anyOf": [
                {
                  "contains": {
                    "type": "object",
                    "properties": {
                      "role": {
                        "const": "layout"
                      }
                    },
                    "required": [
                      "role"
                    ]
                  }
                },
                {
                  "contains": {
                    "type": "object",
                    "properties": {
                      "role": {
                        "const": "positions"
                      }
                    },
                    "required": [
                      "role"
                    ]
                  }
                }
              ]
            }
          },
          "then": {
            "type": "array",
            "items": {
              "if": {
                "type": "object",
                "properties": {
                  "role": {
                    "const": "values"
                  }
                },
                "required": [
                  "role"
                ]
              },
              "then": {
                "type": "object",
                "properties": {
                  "dims": {
                    "type": "array",
                    "items": {
                      "if": {
                        "type": "object",
                        "properties": {
                          "name": {
                            "const": "sensor"
                          }
                        },
                        "required": [
                          "name"
                        ]
                      },
                      "then": {
                        "type": "object",
                        "properties": {
                          "coords": {
                            "type": "object",
                            "not": {
                              "required": [
                                "role"
                              ]
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            },
            "description": "With neither, the values' sensors are named in the values file."
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "type": "object",
        "properties": {
          "data": {
            "type": "array",
            "contains": {
              "type": "object",
              "properties": {
                "role": {
                  "const": "positions"
                }
              },
              "required": [
                "role"
              ]
            }
          }
        },
        "required": [
          "data"
        ]
      },
      "then": {
        "type": "object",
        "required": [
          "transform"
        ],
        "description": "Positions are projected by the declared transform."
      },
      "else": {
        "type": "object",
        "properties": {
          "transform": {
            "not": {},
            "description": "Without positions, a scalp map has no transform."
          }
        }
      }
    }
  ]
}
