{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/nemarOrg/neuroschema/v0.6.0/schema/views/kind.nemar.ic-maps.v1.schema.json",
  "title": "View Kind nemar.ic-maps, Version 1",
  "description": "The scalp maps of the independent components of one decomposition, a preset over nemar.sensor-field version 1, applied on top of the envelope to a view declaration whose kind is nemar.ic-maps and kind_version 1. The role values is the mixing matrix, the sensors along the rows (the layout's rows, by position) and one map per component column (the dimension component, named by the header); the role layout places the sensors; the role components has one row per component, which a renderer prints as that component's text row. docs/views/presets.md is normative; a renderer that knows only nemar.sensor-field draws the values and the layout as maps, because they meet its role contract, and offers the components file for download.",
  "type": "object",
  "required": [
    "base",
    "base_version",
    "data"
  ],
  "properties": {
    "base": {
      "const": "nemar.sensor-field",
      "description": "Drawn over nemar.sensor-field."
    },
    "base_version": {
      "const": 1,
      "description": "nemar.sensor-field version 1."
    },
    "inputs": {
      "not": {},
      "description": "Component maps are stored data only."
    },
    "transform": {
      "not": {},
      "description": "The layout is stored, so no transform projects positions."
    },
    "parameters": {
      "type": "object",
      "maxProperties": 0,
      "description": "Version 1 takes no parameters: each map's color limits are absmax, symmetric about zero, because a component's polarity is arbitrary."
    },
    "data": {
      "type": "array",
      "description": "The roles values, layout and components, each exactly once.",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "description": "The role values: the mixing matrix, sensors by components. It meets nemar.sensor-field's role values; the sensors run along the rows and are the layout's rows, and each declared column is one component's map.",
            "allOf": [
              {
                "$ref": "../views/kind.nemar.sensor-field.v1.schema.json#/properties/data/items/oneOf/0"
              }
            ],
            "properties": {
              "role": {
                "const": "values"
              },
              "format": {
                "const": "tsv"
              },
              "columns": {
                "type": "array",
                "description": "One number column per component, in the decomposition's order.",
                "items": {
                  "type": "object",
                  "properties": {
                    "type": {
                      "const": "number"
                    }
                  }
                }
              },
              "dims": {
                "type": "array",
                "minItems": 2,
                "maxItems": 2,
                "description": "The sensors along the rows, from the layout, and the components along the columns, by header name.",
                "items": {
                  "type": "object",
                  "properties": {
                    "name": {
                      "enum": [
                        "sensor",
                        "component"
                      ]
                    }
                  }
                },
                "allOf": [
                  {
                    "contains": {
                      "type": "object",
                      "required": [
                        "name",
                        "axis",
                        "coords"
                      ],
                      "properties": {
                        "name": {
                          "const": "sensor"
                        },
                        "axis": {
                          "const": "rows"
                        },
                        "coords": {
                          "type": "object",
                          "required": [
                            "role",
                            "column"
                          ],
                          "properties": {
                            "role": {
                              "const": "layout"
                            },
                            "column": {
                              "const": "name"
                            }
                          }
                        }
                      }
                    },
                    "minContains": 1,
                    "maxContains": 1
                  },
                  {
                    "contains": {
                      "type": "object",
                      "required": [
                        "name",
                        "axis",
                        "type",
                        "coords"
                      ],
                      "properties": {
                        "name": {
                          "const": "component"
                        },
                        "axis": {
                          "const": "columns"
                        },
                        "type": {
                          "const": "string"
                        },
                        "coords": {
                          "type": "object",
                          "required": [
                            "header"
                          ]
                        }
                      }
                    },
                    "minContains": 1,
                    "maxContains": 1
                  }
                ]
              }
            }
          },
          {
            "type": "object",
            "description": "The role layout: each sensor's name, theta and radius, as nemar.sensor-field's role layout declares them.",
            "allOf": [
              {
                "$ref": "../views/kind.nemar.sensor-field.v1.schema.json#/properties/data/items/oneOf/1"
              }
            ],
            "properties": {
              "role": {
                "const": "layout"
              },
              "format": {
                "const": "tsv"
              },
              "dims": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "name": {
                      "const": "sensor"
                    }
                  }
                }
              }
            }
          },
          {
            "type": "object",
            "description": "The role components: one row per component, named in the column component, whose other declared columns (such as variance_pct and the class probabilities) a renderer prints as that component's text row.",
            "required": [
              "role",
              "format",
              "columns",
              "dims"
            ],
            "properties": {
              "role": {
                "const": "components"
              },
              "format": {
                "const": "tsv"
              },
              "columns": {
                "type": "array",
                "minItems": 1,
                "description": "The column component, a string, once; the others in the order a text row prints them.",
                "contains": {
                  "type": "object",
                  "required": [
                    "name",
                    "type"
                  ],
                  "properties": {
                    "name": {
                      "const": "component"
                    },
                    "type": {
                      "const": "string"
                    }
                  }
                },
                "minContains": 1,
                "maxContains": 1
              },
              "dims": {
                "type": "array",
                "minItems": 1,
                "maxItems": 1,
                "description": "The components along the rows, named by the column component.",
                "items": {
                  "type": "object",
                  "required": [
                    "name",
                    "axis",
                    "type",
                    "coords"
                  ],
                  "properties": {
                    "name": {
                      "const": "component"
                    },
                    "axis": {
                      "const": "rows"
                    },
                    "type": {
                      "const": "string"
                    },
                    "coords": {
                      "type": "object",
                      "required": [
                        "column"
                      ],
                      "properties": {
                        "column": {
                          "const": "component"
                        }
                      },
                      "not": {
                        "required": [
                          "role"
                        ]
                      }
                    }
                  }
                }
              }
            }
          }
        ]
      },
      "allOf": [
        {
          "contains": {
            "type": "object",
            "properties": {
              "role": {
                "const": "values"
              }
            },
            "required": [
              "role"
            ]
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
            "properties": {
              "role": {
                "const": "layout"
              }
            },
            "required": [
              "role"
            ]
          },
          "minContains": 1,
          "maxContains": 1,
          "description": "The layout is required: the components were classified on these positions, and no map is drawn from names."
        },
        {
          "contains": {
            "type": "object",
            "properties": {
              "role": {
                "const": "components"
              }
            },
            "required": [
              "role"
            ]
          },
          "minContains": 1,
          "maxContains": 1
        }
      ]
    }
  }
}
